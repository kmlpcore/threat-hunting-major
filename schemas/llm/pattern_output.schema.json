{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BehaviourPatterns",
  "type": "object",
  "additionalProperties": false,
  "required": ["patterns"],
  "properties": {
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "narrative", "techniques", "confidence", "evidence_ids"],
        "properties": {
          "title": {"type": "string", "minLength": 3, "maxLength": 200},
          "narrative": {"type": "string", "maxLength": 4000},
          "tactics": {"type": "array", "items": {"type": "string"}},
          "techniques": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}},
          "kill_chain_phase": {"type": ["string", "null"]},
          "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 100},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    }
  }
}
