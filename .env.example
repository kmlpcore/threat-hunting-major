# Copy to .env (`make env`) and change the secrets. Never commit .env.
POSTGRES_USER=engine
POSTGRES_PASSWORD=change-me-postgres
MINIO_ROOT_USER=engine-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
LAKEKEEPER_ENCRYPTION_KEY=change-me-lakekeeper-key
# MinIO is no longer published on Docker Hub/Quay; docker-compose.yml defaults to
# digest-pinned Chainguard builds. Override here to upgrade:
# MINIO_IMAGE=cgr.dev/chainguard/minio:latest
# MC_IMAGE=cgr.dev/chainguard/minio-client:latest

# Pin a Lakekeeper release here for reproducible builds.
LAKEKEEPER_IMAGE=quay.io/lakekeeper/catalog:latest-main

# Object Lock on raw/. Dev default is short and removable so `make clean` works.
# Production (plan.md 12, policies/retention.yaml): RAW_LOCK_MODE=COMPLIANCE RAW_LOCK_PERIOD=15y
RAW_LOCK_MODE=GOVERNANCE
RAW_LOCK_PERIOD=1d

# M6 - behaviour enrichment. Unset = offline heuristic in compose (nothing leaves the host).
# For Groq: LLM_PROVIDER=groq, GROQ_API_KEY=..., LLM_MODEL=<a Groq model id>. Any OpenAI-compatible
# endpoint works with LLM_PROVIDER=openai|vllm|ollama plus LLM_BASE_URL / LLM_API_KEY.
# LLM_PROVIDER=offline
# LLM_MODEL=
# GROQ_API_KEY=
# HMAC key for pseudonyms of users/hosts/IPs (stays inside the org). REQUIRED outside dev.
PSEUDONYMISATION_HMAC_KEY=change-me-pseudonymisation-key

# M7 - TI feeds. 1 = connectors read the synthetic samples in data/feeds/samples (no network).
TI_FEEDS_OFFLINE=1
# THREATFOX_AUTH_KEY=        # free abuse.ch account (ThreatFox API); ABUSECH_AUTH_KEY for URLhaus/Bazaar
# MISP_API_KEY=  OTX_API_KEY=  ABUSEIPDB_API_KEY=  TAXII21_TOKEN=  TAXII1_CREDENTIALS=user:password
